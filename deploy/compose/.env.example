# PostgreSQL connection string. Inside Compose the host is the db service.
DATABASE_URL=postgres://lkv:change-me@db:5432/lkv?sslmode=disable
# 32 bytes, standard base64. Make one with: openssl rand -base64 32
MASTER_KEY=
# S3-compatible endpoint. An absolute http or https URL with a host.
S3_ENDPOINT=https://example.invalid
# Region string the endpoint expects.
S3_REGION=us-east-1
# Bucket the operator already created.
S3_BUCKET=lkv
# Access key for the bucket.
S3_ACCESS_KEY=change-me
# Secret key for the bucket.
S3_SECRET_KEY=change-me
# Path-style addressing. Default false. Use true for rustfs or MinIO.
S3_PATH_STYLE=false
# TCP port. Default 8080.
PORT=8080
# Optional absolute http or https URL, printed in the startup log.
PUBLIC_URL=
# Allow reads without a token. Default false.
ANONYMOUS_READ=false
# Reject a push that is not a fast-forward. Default true.
DENY_NON_FAST_FORWARD=true
# Create a repository on the first push to an unknown name. Default false.
AUTO_CREATE=false
# Role, password, and database name for the Compose db service.
POSTGRES_USER=lkv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lkv
